<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_obstacle_avoidance" default="false"/>
  <!-- Track selection: citycircuit uses ten_config.yaml/ten_ref_vel.yaml (our tuning copies of the
       upstream config.yaml/ref_vel.yaml); other tracks use config_<track>.yaml/ref_vel_<track>.yaml.
       Pass config_file:=config.yaml ref_vel_file:=ref_vel.yaml to fall back to the upstream settings. -->
  <arg name="track" default="citycircuit"/>
  <!-- 環境変数 MPC_CONFIG / MPC_REF_VEL があればそちらを優先する。
       ローカル検証で敵車を「デフォルト設定の(遅い)MPC」にするために使う。 -->
  <arg name="config_file" default="$(env MPC_CONFIG $(eval &quot;'ten_config.yaml' if '$(var track)' == 'citycircuit' else 'config_' + '$(var track)' + '.yaml'&quot;))"/>
  <arg name="ref_vel_file" default="$(env MPC_REF_VEL $(eval &quot;'ten_ref_vel.yaml' if '$(var track)' == 'citycircuit' else 'ref_vel_' + '$(var track)' + '.yaml'&quot;))"/>

  <node pkg="multi_purpose_mpc_ros" exec="run_mpc_controller.bash"
        name="mpc_controller" output="screen"
        args="--config_path $(find-pkg-share multi_purpose_mpc_ros)/config/$(var config_file)
              --ref_vel_path $(find-pkg-share multi_purpose_mpc_ros)/config/$(var ref_vel_file)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="use_boost_acceleration" value="false"/>
    <param name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
    <param name="use_stats" value="false"/>
  </node>
</launch>
